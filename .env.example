# Projeto Supabase "presence" (compartilhado com o assistente virtual).
# Este app usa somente o schema `presence_app`. A chave publishable é pública por design.
VITE_SUPABASE_URL=https://jfdsqcasoeqrqhbtqkpw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oDzgy_HN9tuT3fE0UVl53w_saClfZOj

# Somente no servidor (nunca use o prefixo VITE_): chave da API da Anthropic para a assistente.
ANTHROPIC_API_KEY=

# Somente no servidor: segredo do endpoint MCP (/api/mcp). Sem ele o endpoint fica desligado (503).
# Gere um valor longo e aleatório, por exemplo: openssl rand -hex 32  (mínimo 24 caracteres).
MCP_TOKEN=

# Somente no servidor: IA da Central de entrada (tela inicial). O modelo é opcional (padrão gpt-6.1-terra).
OPENAI_API_KEY=
OPENAI_MODEL=

# Somente no servidor: acordar o Claude na hora em que um pedido de melhoria é confirmado (gatilho por API da rotina).
# No claude.ai/code/routines: abrir a rotina "Orion: pegar pedidos de melhoria confirmados" > Edit > Trigger + > API.
# Copie a "Fire URL" e gere o token (aparece uma vez). Sem isso, o pedido só entra na fila.
ORION_ROUTINE_FIRE_URL=
ORION_ROUTINE_FIRE_TOKEN=
